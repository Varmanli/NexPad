# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Your production domain (no trailing slash). Used for SSR fetch calls & SEO.
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/nexpad
MONGODB_URI=mongodb://127.0.0.1:27017/nexpad

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-secure-random-secret-min-32-chars

# ── ArvanCloud S3-compatible Storage ──────────────────────────────────────────
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_ACCESS_KEY=your-arvan-access-key
ARVAN_SECRET_KEY=your-arvan-secret-key
ARVAN_BUCKET=your-bucket-name
